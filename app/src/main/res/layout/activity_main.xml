<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/region"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Movilidad Sostenible para todo Quito."
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.468"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ima_logo"
        app:layout_constraintVertical_bias="0.193" />

    <ImageView
        android:id="@+id/ima_logo"
        android:layout_width="321dp"
        android:layout_height="114dp"
        android:layout_marginTop="124dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/biciquito_svg" />

    <Button
        android:id="@+id/btn_crear_cuenta"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:backgroundTint="#D32E2E"
        android:insetLeft="8dp"
        android:insetRight="8dp"
        android:text="Crear una cuenta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_home"
        app:strokeWidth="1dp" />

    <Button
        android:id="@+id/btn_tengo_cuenta"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:backgroundTint="#D7D5D5"
        android:insetLeft="4dp"
        android:insetRight="4dp"
        android:text="Ya tengo cuenta"
        android:textColor="#313030"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_crear_cuenta"
        app:layout_constraintVertical_bias="0.0"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>